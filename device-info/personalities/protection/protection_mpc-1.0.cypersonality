<?xml version='1.0' encoding='utf-8'?>

<PersonalityTemplate id='protection_mpc' name='MPC' version='1.0' xmlns='http://cypress.com/xsd/cyhwpersonality_v14'>
  <Constants>
    <Const id="PROTECTION_LOC" value='vres[0].protection[0]'/>
    <Const id='MAX_DOMAIN_COUNT' value='16' />
    <Const id='PC_COUNT' value='8' />
    <Const id='MAX_MEM_REGIONS' value='64' />
    <Const id="M33_BUS_MASTER_ID" value="0" />
    <Const id="M55_BUS_MASTER_ID" value="19" />
    <Const id="TC_BUS_MASTER_ID" value="31" />
  </Constants>

  <FittingRules>
    <MappingRules>
      <IpBlock name='VirtualResource' />
      <Resource name='vres\.protection\.mpc' />
      <OperatingMode value="MCU" />
    </MappingRules>
  </FittingRules>

  <BehaviorImplementation>
    <Implements type="mpc_v1">
      <ExposedMember key='responseFlash' paramId='responseFlash' />
      <ExposedMember key='responseRRAM' paramId='responseRRAM' />
      <ExposedMember key='responseSMIF0' paramId='responseSMIF0' />
      <ExposedMember key='responseSMIF1' paramId='responseSMIF1' />
      <ExposedMember key='responseSOCMEM' paramId='responseSOCMEM' />
      <ExposedMember key='responseSRAM0' paramId='responseSRAM0' />
      <ExposedMember key='responseSRAM1' paramId='responseSRAM1' />
      <ExposedMember key='responsePROMC' paramId='responsePROMC' />
      <ExposedMember key='responsePPCASRAM0' paramId='responsePPCASRAM0' />
      <ExposedMember key='responsePPCASRAM1' paramId='responsePPCASRAM1' />
      <ExposedMember key='responsePPCASRAM2' paramId='responsePPCASRAM2' />
      <ExposedMember key='responsePPCASRAM3' paramId='responsePPCASRAM3' />
      <ExposedMember key='responsePPCASRAM4' paramId='responsePPCASRAM4' />
    </Implements>
  </BehaviorImplementation>

  <Parameters>
    <ParamDoc id='doc' name='Configuration Help' group='Overview' default='file:///`${cy_libs_path()}`/docs/html/page_prot_person.html#MPC_personality' linkText='Open MPC Documentation' visible='true' desc='Open MPC Documentation' />

    <!-- Calculated here to not allow a response setting to be configured if no memory regions are associated with a particular physical memory -->
    <ParamString id='hasFlash' name="hasFlash" default='`${hasBlock("flashc[0].mpc[0]")}`' visible='false' />
    <ParamString id='hasRRAM' name="hasRRAM" default='`${hasBlock("mxrramc[0].mpc[0]")}`' visible='false' />
    <ParamString id='hasSMIF0' name="hasSMIF0" default='`${hasBlock("smif[0].mpc[0]")}`' visible='false' />
    <ParamString id='hasSMIF1' name="hasSMIF1" default='`${hasBlock("smif[1].mpc[0]")}`' visible='false' />
    <ParamString id='hasSOCMEM' name="hasSOCMEM" default='`${hasBlock("socmem[0].mpc[0]")}`' visible='false' />
    <ParamString id='hasSRAM0' name="hasSRAM0" default='`${hasBlock("mxsramc[0].mpc[0]")}`' visible='false' />
    <ParamString id='hasSRAM1' name="hasSRAM1" default='`${hasBlock("mxsramc[1].mpc[0]")}`' visible='false' />
    <ParamString id='hasPROMC' name="hasPROMC" default='`${hasBlock("mxpromc[0].mpc[0]")}`' visible='false' />
    <ParamString id='hasPPCASRAM0' name="hasPPCASRAM0" default='`${hasBlock("ppca[0].cpuss_cnfg[0].mxsramc[0].mpc[0]")}`' visible='false' />
    <ParamString id='hasPPCASRAM1' name="hasPPCASRAM1" default='`${hasBlock("ppca[0].cpuss_cnfg[0].mxsramc[1].mpc[0]")}`' visible='false' />
    <ParamString id='hasPPCASRAM2' name="hasPPCASRAM2" default='`${hasBlock("ppca[0].cpuss_cnfg[0].mxsramc[2].mpc[0]")}`' visible='false' />
    <ParamString id='hasPPCASRAM3' name="hasPPCASRAM3" default='`${hasBlock("ppca[0].cpuss_cnfg[0].mxsramc[3].mpc[0]")}`' visible='false' />
    <ParamString id='hasPPCASRAM4' name="hasPPCASRAM4" default='`${hasBlock("ppca[0].cpuss_cnfg[0].mxsramc[4].mpc[0]")}`' visible='false' />

    <!-- ROT Configurability per memory type (from device-db, defaults to true for BWC) -->
    <ParamBool id='rotConfigurableFlash' name="rotConfigurableFlash"
        default='`${isBlockUsed("flashc[0].mpc[0]") ? getExposedMember("flashc[0].mpc[0]", "rot_configurable") : true}`' visible='false' editable='false' />
    <ParamBool id='rotConfigurableRRAM' name="rotConfigurableRRAM"
        default='`${isBlockUsed("mxrramc[0].mpc[0]") ? getExposedMember("mxrramc[0].mpc[0]", "rot_configurable") : true}`' visible='false' editable='false' />
    <ParamBool id='rotConfigurableSMIF0' name="rotConfigurableSMIF0"
        default='`${isBlockUsed("smif[0].mpc[0]") ? getExposedMember("smif[0].mpc[0]", "rot_configurable") : true}`' visible='false' editable='false' />
    <ParamBool id='rotConfigurableSMIF1' name="rotConfigurableSMIF1"
        default='`${isBlockUsed("smif[1].mpc[0]") ? getExposedMember("smif[1].mpc[0]", "rot_configurable") : true}`' visible='false' editable='false' />
    <ParamBool id='rotConfigurableSOCMEM' name="rotConfigurableSOCMEM"
        default='`${isBlockUsed("socmem[0].mpc[0]") ? getExposedMember("socmem[0].mpc[0]", "rot_configurable") : true}`' visible='false' editable='false' />
    <ParamBool id='rotConfigurableSRAM0' name="rotConfigurableSRAM0"
        default='`${isBlockUsed("mxsramc[0].mpc[0]") ? getExposedMember("mxsramc[0].mpc[0]", "rot_configurable") : true}`' visible='false' editable='false' />
    <ParamBool id='rotConfigurableSRAM1' name="rotConfigurableSRAM1"
        default='`${isBlockUsed("mxsramc[1].mpc[0]") ? getExposedMember("mxsramc[1].mpc[0]", "rot_configurable") : true}`' visible='false' editable='false' />
    <ParamBool id='rotConfigurablePROMC' name="rotConfigurablePROMC"
        default='`${isBlockUsed("mxpromc[0].mpc[0]") ? getExposedMember("mxpromc[0].mpc[0]", "rot_configurable") : true}`' visible='false' editable='false' />
    <ParamBool id='rotConfigurablePPCASRAM0' name="rotConfigurablePPCASRAM0"
        default='`${isBlockUsed("ppca[0].cpuss_cnfg[0].mxsramc[0].mpc[0]") ? getExposedMember("ppca[0].cpuss_cnfg[0].mxsramc[0].mpc[0]", "rot_configurable") : true}`' visible='false' editable='false' />
    <ParamBool id='rotConfigurablePPCASRAM1' name="rotConfigurablePPCASRAM1"
        default='`${isBlockUsed("ppca[0].cpuss_cnfg[0].mxsramc[1].mpc[0]") ? getExposedMember("ppca[0].cpuss_cnfg[0].mxsramc[1].mpc[0]", "rot_configurable") : true}`' visible='false' editable='false' />
    <ParamBool id='rotConfigurablePPCASRAM2' name="rotConfigurablePPCASRAM2"
        default='`${isBlockUsed("ppca[0].cpuss_cnfg[0].mxsramc[2].mpc[0]") ? getExposedMember("ppca[0].cpuss_cnfg[0].mxsramc[2].mpc[0]", "rot_configurable") : true}`' visible='false' editable='false' />
    <ParamBool id='rotConfigurablePPCASRAM3' name="rotConfigurablePPCASRAM3"
        default='`${isBlockUsed("ppca[0].cpuss_cnfg[0].mxsramc[3].mpc[0]") ? getExposedMember("ppca[0].cpuss_cnfg[0].mxsramc[3].mpc[0]", "rot_configurable") : true}`' visible='false' editable='false' />
    <ParamBool id='rotConfigurablePPCASRAM4' name="rotConfigurablePPCASRAM4"
        default='`${isBlockUsed("ppca[0].cpuss_cnfg[0].mxsramc[4].mpc[0]") ? getExposedMember("ppca[0].cpuss_cnfg[0].mxsramc[4].mpc[0]", "rot_configurable") : true}`' visible='false' editable='false' />

    <ParamString id='regionCountFlash' name="regionCountFlash" default='`${hasFlash ? splitCount(getMpcRegionStarts("flashc[0].mpc[0]")) : ""}`' visible='false' />
    <ParamString id='regionCountRRAM' name="regionCountRRAM" default='`${hasRRAM ? splitCount(getMpcRegionStarts("mxrramc[0].mpc[0]")) : ""}`' visible='false' />
    <ParamString id='regionCountSMIF0' name="regionCountSMIF0" default='`${hasSMIF0 ? splitCount(getMpcRegionStarts("smif[0].mpc[0]")) : ""}`' visible='false' />
    <ParamString id='regionCountSMIF1' name="regionCountSMIF1" default='`${hasSMIF1 ? splitCount(getMpcRegionStarts("smif[1].mpc[0]")) : ""}`' visible='false' />
    <ParamString id='regionCountSOCMEM' name="regionCountSOCMEM" default='`${hasSOCMEM ? splitCount(getMpcRegionStarts("socmem[0].mpc[0]")) : ""}`' visible='false' />
    <ParamString id='regionCountSRAM0' name="regionCountSRAM0" default='`${hasSRAM0 ? splitCount(getMpcRegionStarts("mxsramc[0].mpc[0]")) : ""}`' visible='false' />
    <ParamString id='regionCountSRAM1' name="regionCountSRAM1" default='`${hasSRAM1 ? splitCount(getMpcRegionStarts("mxsramc[1].mpc[0]")) : ""}`' visible='false' />
    <ParamString id='regionCountPROMC' name="regionCountPROMC" default='`${hasPROMC ? splitCount(getMpcRegionStarts("mxpromc[0].mpc[0]")) : ""}`' visible='false' />
    <ParamString id='regionCountPPCASRAM0' name="regionCountPPCASRAM0" default='`${hasPPCASRAM0 ? splitCount(getMpcRegionStarts("ppca[0].cpuss_cnfg[0].mxsramc[0].mpc[0]")) : ""}`' visible='false' />
    <ParamString id='regionCountPPCASRAM1' name="regionCountPPCASRAM1" default='`${hasPPCASRAM1 ? splitCount(getMpcRegionStarts("ppca[0].cpuss_cnfg[0].mxsramc[1].mpc[0]")) : ""}`' visible='false' />
    <ParamString id='regionCountPPCASRAM2' name="regionCountPPCASRAM2" default='`${hasPPCASRAM2 ? splitCount(getMpcRegionStarts("ppca[0].cpuss_cnfg[0].mxsramc[2].mpc[0]")) : ""}`' visible='false' />
    <ParamString id='regionCountPPCASRAM3' name="regionCountPPCASRAM3" default='`${hasPPCASRAM3 ? splitCount(getMpcRegionStarts("ppca[0].cpuss_cnfg[0].mxsramc[3].mpc[0]")) : ""}`' visible='false' />
    <ParamString id='regionCountPPCASRAM4' name="regionCountPPCASRAM4" default='`${hasPPCASRAM4 ? splitCount(getMpcRegionStarts("ppca[0].cpuss_cnfg[0].mxsramc[4].mpc[0]")) : ""}`' visible='false' />

    <ParamString id='flashName' name="flashName" default='`${hasFlash ? getBlockDisplayName("flashc[0].mpc[0]",true) : ""}`' visible='false' />
    <ParamString id='rramName' name="rramName" default='`${hasRRAM ? getBlockDisplayName("mxrramc[0].mpc[0]",true) : ""}`' visible='false' />
    <ParamString id='smif0Name' name="smif0Name" default='`${hasSMIF0 ? getBlockDisplayName("smif[0].mpc[0]",true) : ""}`' visible='false' />
    <ParamString id='smif1Name' name="smif1Name" default='`${hasSMIF1 ? getBlockDisplayName("smif[1].mpc[0]",true) : ""}`' visible='false' />
    <ParamString id='socmemName' name="socmemName" default='`${hasSOCMEM ? getBlockDisplayName("socmem[0].mpc[0]",true) : ""}`' visible='false' />
    <ParamString id='sram0Name' name="sram0Name" default='`${hasSRAM0 ? getBlockDisplayName("mxsramc[0].mpc[0]",true) : ""}`' visible='false' />
    <ParamString id='sram1Name' name="sram1Name" default='`${hasSRAM1 ? getBlockDisplayName("mxsramc[1].mpc[0]",true) : ""}`' visible='false' />
    <ParamString id='promcName' name="promcName" default='`${hasPROMC ? getBlockDisplayName("mxpromc[0].mpc[0]",true) : ""}`' visible='false' />
    <ParamString id='ppcasram0Name' name="ppcasram0Name" default='`${hasPPCASRAM0 ? "PPCA " . getBlockDisplayName("ppca[0].cpuss_cnfg[0].mxsramc[0].mpc[0]",true) : ""}`' visible='false' />
    <ParamString id='ppcasram1Name' name="ppcasram1Name" default='`${hasPPCASRAM1 ? "PPCA " . getBlockDisplayName("ppca[0].cpuss_cnfg[0].mxsramc[1].mpc[0]",true) : ""}`' visible='false' />
    <ParamString id='ppcasram2Name' name="ppcasram2Name" default='`${hasPPCASRAM2 ? "PPCA " . getBlockDisplayName("ppca[0].cpuss_cnfg[0].mxsramc[2].mpc[0]",true) : ""}`' visible='false' />
    <ParamString id='ppcasram3Name' name="ppcasram3Name" default='`${hasPPCASRAM3 ? "PPCA " . getBlockDisplayName("ppca[0].cpuss_cnfg[0].mxsramc[3].mpc[0]",true) : ""}`' visible='false' />
    <ParamString id='ppcasram4Name' name="ppcasram4Name" default='`${hasPPCASRAM4 ? "PPCA " . getBlockDisplayName("ppca[0].cpuss_cnfg[0].mxsramc[4].mpc[0]",true) : ""}`' visible='false' />

    <ParamString id='mpcCount' name="Number of MPCs" default='`${hasFlash + hasRRAM + hasSMIF0 + hasSMIF1 + hasSOCMEM + hasSRAM0 + hasSRAM1 + hasPROMC + hasPPCASRAM0 + hasPPCASRAM1 + hasPPCASRAM2 + hasPPCASRAM3 + hasPPCASRAM4}`' desc='Number of available MPCs' visible='false'/>
    
    <ParamChoice id='responseFlash' name='`${flashName}`' group='Invalid Access Response' default='CY_MPC_BUS_ERR' visible='`${hasFlash}`'
      editable='false' desc='The access response for the Flash memory is configured at boot and is not configurable by the user.'>
      <Entry name='Read Zero and Write Ignore' value='CY_MPC_RZWI' visible='true' />
      <Entry name='Bus Error' value='CY_MPC_BUS_ERR' visible='true' />
    </ParamChoice>
    <ParamChoice id='responseRRAM' name='`${rramName}`' group='Invalid Access Response' default='CY_MPC_BUS_ERR' visible='`${hasRRAM}`'
      editable='false' desc='The access response for the RRAM memory is configured at boot and is not configurable by the user.'>
      <Entry name='Read Zero and Write Ignore' value='CY_MPC_RZWI' visible='true' />
      <Entry name='Bus Error' value='CY_MPC_BUS_ERR' visible='true' />
    </ParamChoice>
    <ParamChoice id='responseSMIF0' name='`${smif0Name}`' group='Invalid Access Response' default='CY_MPC_BUS_ERR' visible='`${hasSMIF0}`'
      editable='`${(regionCountSMIF0 &gt; 0)}`' 
      desc='`${(regionCountSMIF0 &gt; 0 ? "Determines what happens when the SMIF0 memory is accessed from a protection context that does not allow access. Response setting is only configurable if there are memory regions configured within the physical memory."
      : "The access response for the SMIF0 memory is configured at boot and is not configurable by the user.")}`'>
      <Entry name='Read Zero and Write Ignore' value='CY_MPC_RZWI' visible='true' />
      <Entry name='Bus Error' value='CY_MPC_BUS_ERR' visible='true' />
    </ParamChoice>
    <ParamChoice id='responseSMIF1' name='`${smif1Name}`' group='Invalid Access Response' default='CY_MPC_BUS_ERR' visible='`${hasSMIF1}`'
      editable='`${(regionCountSMIF1 &gt; 0)}`' 
      desc='`${(regionCountSMIF1 &gt; 0 ? "Determines what happens when the SMIF1 memory is accessed from a protection context that does not allow access. Response setting is only configurable if there are memory regions configured within the physical memory."
      : "The access response for the SMIF1 memory is configured at boot and is not configurable by the user.")}`'>
      <Entry name='Read Zero and Write Ignore' value='CY_MPC_RZWI' visible='true' />
      <Entry name='Bus Error' value='CY_MPC_BUS_ERR' visible='true' />
    </ParamChoice>
    <ParamChoice id='responseSOCMEM' name='`${socmemName}`' group='Invalid Access Response' default='CY_MPC_BUS_ERR' visible='`${hasSOCMEM}`'
      editable='`${(regionCountSOCMEM &gt; 0)}`'
      desc='`${(regionCountSOCMEM &gt; 0 ? "Determines what happens when the SOCMEM memory is accessed from a protection context that does not allow access. Response setting is only configurable if there are memory regions configured within the physical memory."
      : "The access response for the SOCMEM memory is configured at boot and is not configurable by the user.")}`'>
      <Entry name='Read Zero and Write Ignore' value='CY_MPC_RZWI' visible='true' />
      <Entry name='Bus Error' value='CY_MPC_BUS_ERR' visible='true' />
    </ParamChoice>
    <ParamChoice id='responseSRAM0' name='`${sram0Name}`' group='Invalid Access Response' default='CY_MPC_BUS_ERR' visible='`${hasSRAM0}`'
      editable='`${(regionCountSRAM0 &gt; 0)}`' 
      desc='`${(regionCountSRAM0 &gt; 0 ? "Determines what happens when the SRAM0 memory is accessed from a protection context that does not allow access. Response setting is only configurable if there are memory regions configured within the physical memory."
      : "The access response for the SRAM0 memory is configured at boot and is not configurable by the user.")}`'>
      <Entry name='Read Zero and Write Ignore' value='CY_MPC_RZWI' visible='true' />
      <Entry name='Bus Error' value='CY_MPC_BUS_ERR' visible='true' />
    </ParamChoice>
    <ParamChoice id='responseSRAM1' name='`${sram1Name}`' group='Invalid Access Response' default='CY_MPC_BUS_ERR' visible='`${hasSRAM1}`'
      editable='`${(regionCountSRAM1 &gt; 0)}`' 
      desc='`${(regionCountSRAM1 &gt; 0 ? "Determines what happens when the SRAM1 memory is accessed from a protection context that does not allow access. Response setting is only configurable if there are memory regions configured within the physical memory."
      : "The access response for the SRAM1 memory is configured at boot and is not configurable by the user.")}`'>
      <Entry name='Read Zero and Write Ignore' value='CY_MPC_RZWI' visible='true' />
      <Entry name='Bus Error' value='CY_MPC_BUS_ERR' visible='true' />
    </ParamChoice>
    <ParamChoice id='responsePROMC' name='`${promcName}`' group='Invalid Access Response' default='CY_MPC_BUS_ERR' visible='`${hasPROMC}`'
      editable='`${(regionCountPROMC &gt; 0)}`' 
      desc='`${(regionCountPROMC &gt; 0 ? "Determines what happens when the PROMC memory is accessed from a protection context that does not allow access. Response setting is only configurable if there are memory regions configured within the physical memory."
      : "The access response for the PROMC memory is configured at boot and is not configurable by the user.")}`'>
      <Entry name='Read Zero and Write Ignore' value='CY_MPC_RZWI' visible='true' />
      <Entry name='Bus Error' value='CY_MPC_BUS_ERR' visible='true' />
    </ParamChoice>
    <ParamChoice id='responsePPCASRAM0' name='`${ppcasram0Name}`' group='Invalid Access Response' default='CY_MPC_BUS_ERR' visible='`${hasPPCASRAM0}`'
      editable='`${(regionCountPPCASRAM0 &gt; 0)}`' 
      desc='`${(regionCountPPCASRAM0 &gt; 0 ? "Determines what happens when the PPCA SRAM0 memory is accessed from a protection context that does not allow access. Response setting is only configurable if there are memory regions configured within the physical memory."
      : "The access response for the PPCA SRAM0 memory is configured at boot and is not configurable by the user.")}`'>
      <Entry name='Read Zero and Write Ignore' value='CY_MPC_RZWI' visible='true' />
      <Entry name='Bus Error' value='CY_MPC_BUS_ERR' visible='true' />
    </ParamChoice>
    <ParamChoice id='responsePPCASRAM1' name='`${ppcasram1Name}`' group='Invalid Access Response' default='CY_MPC_BUS_ERR' visible='`${hasPPCASRAM1}`'
      editable='`${(regionCountPPCASRAM1 &gt; 0)}`' 
      desc='`${(regionCountPPCASRAM1 &gt; 0 ? "Determines what happens when the PPCA SRAM1 memory is accessed from a protection context that does not allow access. Response setting is only configurable if there are memory regions configured within the physical memory."
      : "The access response for the PPCA SRAM1 memory is configured at boot and is not configurable by the user.")}`'>
      <Entry name='Read Zero and Write Ignore' value='CY_MPC_RZWI' visible='true' />
      <Entry name='Bus Error' value='CY_MPC_BUS_ERR' visible='true' />
    </ParamChoice>
    <ParamChoice id='responsePPCASRAM2' name='`${ppcasram2Name}`' group='Invalid Access Response' default='CY_MPC_BUS_ERR' visible='`${hasPPCASRAM2}`'
      editable='`${(regionCountPPCASRAM2 &gt; 0)}`' 
      desc='`${(regionCountPPCASRAM2 &gt; 0 ? "Determines what happens when the PPCA SRAM2 memory is accessed from a protection context that does not allow access. Response setting is only configurable if there are memory regions configured within the physical memory."
      : "The access response for the PPCA SRAM2 memory is configured at boot and is not configurable by the user.")}`'>
      <Entry name='Read Zero and Write Ignore' value='CY_MPC_RZWI' visible='true' />
      <Entry name='Bus Error' value='CY_MPC_BUS_ERR' visible='true' />
    </ParamChoice>
    <ParamChoice id='responsePPCASRAM3' name='`${ppcasram3Name}`' group='Invalid Access Response' default='CY_MPC_BUS_ERR' visible='`${hasPPCASRAM3}`'
      editable='`${(regionCountPPCASRAM3 &gt; 0)}`' 
      desc='`${(regionCountPPCASRAM3 &gt; 0 ? "Determines what happens when the PPCA SRAM3 memory is accessed from a protection context that does not allow access. Response setting is only configurable if there are memory regions configured within the physical memory."
      : "The access response for the PPCA SRAM3 memory is configured at boot and is not configurable by the user.")}`'>
      <Entry name='Read Zero and Write Ignore' value='CY_MPC_RZWI' visible='true' />
      <Entry name='Bus Error' value='CY_MPC_BUS_ERR' visible='true' />
    </ParamChoice>
    <ParamChoice id='responsePPCASRAM4' name='`${ppcasram4Name}`' group='Invalid Access Response' default='CY_MPC_BUS_ERR' visible='`${hasPPCASRAM4}`'
      editable='`${(regionCountPPCASRAM4 &gt; 0)}`' 
      desc='`${(regionCountPPCASRAM4 &gt; 0 ? "Determines what happens when the PPCA SRAM4 memory is accessed from a protection context that does not allow access. Response setting is only configurable if there are memory regions configured within the physical memory."
      : "The access response for the PPCA SRAM4 memory is configured at boot and is not configurable by the user.")}`'>
      <Entry name='Read Zero and Write Ignore' value='CY_MPC_RZWI' visible='true' />
      <Entry name='Bus Error' value='CY_MPC_BUS_ERR' visible='true' />
    </ParamChoice>

    <!-- Domains accumulation -->
    <Repeat count='$MAX_DOMAIN_COUNT'>
        <ParamString id='prev_domain_name$idx' name='prev_domain_name$idx' default='`${$idx == 0 ? "" : getParamValue("accumulated_domain_name" . ($idx - 1))}`' />
        <ParamString id='accumulated_domain_name$idx' name='accumulated_domain_name$idx' default='`${($idx &lt; $MAX_DOMAIN_COUNT) ? (prev_domain_name$idx ne "" ? prev_domain_name$idx . "," : "") . getOrDefault(getExposedMember("vres[0].protection[0].domain[$idx]", "displayName"), ",") : prev_domain_name$idx}`' />
    </Repeat>
    <!-- Get the indexed Domains for the MPC -->
    <ParamString id='mpc_domains_idx_tcl' name='MPC Domain TCL Call' default='`${runTcl("protection_mpc_index_domains-1.0.tcl", getParamValue("accumulated_domain_name". ($MAX_DOMAIN_COUNT - 1)))}`' />
    <ParamString id='tcl_mpc_domain_indexes' name='tcl_mpc_domain_indexes' default='`${mpc_domains_idx_tcl ne "" ? getTclVar("mpc_indexed_domains", mpc_domains_idx_tcl) : ""}`' />
    <Repeat count='$MAX_DOMAIN_COUNT'>
        <ParamString id='mpc_domain_idx$idx' name='mpc_domain_idx$idx' default='`${splitAt(tcl_mpc_domain_indexes, $idx, ",")}`' />
    </Repeat>

  </Parameters>

  <Variables>
    <!-- Flash Regions -->
    <Variable id='regionStartsFlash' value='`${hasFlash ? getMpcRegionStarts("flashc[0].mpc[0]") : ""}`' />
    <Variable id='regionEndsFlash' value='`${hasFlash ? getMpcRegionEnds("flashc[0].mpc[0]") : ""}`' />
    <Variable id='regionDomainsFlash' value='`${hasFlash ? getMpcRegionDomainIds("flashc[0].mpc[0]") : ""}`' />
    <Variable id='regionDomainCountFlash' value='`${(regionDomainsFlash ne "") ? splitCount(regionDomainsFlash) : 0}`' />

    <!-- RRAM Regions -->
    <Variable id='regionStartsRRAM' value='`${hasRRAM ? getMpcRegionStarts("mxrramc[0].mpc[0]") : ""}`' />
    <Variable id='regionEndsRRAM' value='`${hasRRAM ? getMpcRegionEnds("mxrramc[0].mpc[0]") : ""}`' />
    <Variable id='regionDomainsRRAM' value='`${hasRRAM ? getMpcRegionDomainIds("mxrramc[0].mpc[0]") : ""}`' />
    <Variable id='regionDomainCountRRAM' value='`${(regionDomainsRRAM ne "") ? splitCount(regionDomainsRRAM) : 0}`' />

