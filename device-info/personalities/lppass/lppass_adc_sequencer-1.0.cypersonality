<PersonalityTemplate id='lppass_adc_sequencer' name='SAR ADC Sequencer' version='1.0' xmlns='http://cypress.com/xsd/cyhwpersonality_v10'>

 <FittingRules>
  <MappingRules>
    <IpBlock name='mxs22lppass' />
    <Resource name='pass\.sar\.group\.scan'/>
  </MappingRules>
 </FittingRules>

  <ExposedMembers>
    <ExposedMember key='channelGpio'                   paramId='channelGpio'/>
    <ExposedMember key='channelMux'                    paramId='channelMux'/>
    <ExposedMember key='sampleTimeEnable'              paramId='sampleTimeEnable'/>
    <ExposedMember key='sampleTimeSelect'              paramId='sampleTimeSelect'/>
    <ExposedMember key='accumulationEnable'            paramId='accumulationEnable'/>
    <ExposedMember key='accCount'                      paramId='accCount'/>
    <ExposedMember key='calibrationInRuntime'          paramId='calibrationInRuntime'/>
    <ExposedMember key='nonSimultaneousSamplingGPIOch' paramId='nonSimultaneousSamplingGPIOch'/>
    <ExposedMember key='simultaneousSamplingGPIOch'    paramId='simultaneousSamplingGPIOch'/>
    <ExposedMember key='nonSimultaneousMuxMode'        paramId='nonSimultaneousMuxMode'/>
    <ExposedMember key='simultaneousMuxMode'           paramId='simultaneousMuxMode'/>
    <ExposedMember key='nonSimultaneousMux0Sel'        paramId='nonSimultaneousMux0Sel'/>
    <ExposedMember key='simultaneousMux0Sel'           paramId='simultaneousMux0Sel'/>
    <ExposedMember key='simultaneousMux1Sel'           paramId='simultaneousMux1Sel'/>
  </ExposedMembers>

  <Parameters>

<!-- Debug -->
    <ParamBool   id='debug'
                 name='debug'
                 group='Internal'
                 default='false'
                 visible='false'
                 editable='true'
                 desc='' />

<!-- LPPASS instances -->
    <ParamString id='inst_pass'
                 name='inst_pass'
                 group='Internal'
                 default='`${getInstNumber("pass")}`'
                 visible='`${debug}`'
                 editable='false'
                 desc='' />

    <ParamString id='inst_ac'
                 name='inst_ac'
                 group='Internal'
                 default='`${getInstNumber("ac")}`'
                 visible='`${debug}`'
                 editable='false'
                 desc='' />

    <ParamString id='inst_sar'
                 name='inst_sar'
                 group='Internal'
                 default='`${getInstNumber("sar")}`'
                 visible='`${debug}`'
                 editable='false'
                 desc='' />

    <ParamString id='inst_group'
                 name='inst_group'
                 group='Internal'
                 default='`${getInstNumber("group")}`'
                 visible='`${debug}`'
                 editable='false'
                 desc='' />

<!-- LPPASS resources -->
    <ParamString id='resource_pass'
                 name='resource_pass'
                 group='Internal'
                 default='pass[`${inst_pass}`]'
                 visible='`${debug}`'
                 editable='false'
                 desc='' />

    <ParamString id='resource_ac'
                 name='resource_ac'
                 group='Internal'
                 visible='`${debug}`'
                 desc=''
                 editable='false'
                 default='`${"pass[" . inst_pass . "].ac[" . 0 . "]"}`'/>

    <ParamString id='resource_sar'
                 name='resource_sar'
                 group='Internal'
                 visible='`${debug}`'
                 desc=''
                 editable='false'
                 default='`${"pass[" . inst_pass . "].sar[" . inst_sar . "]"}`'/>

    <ParamString id='resource_group'
                 name='resource_group'
                 group='Internal'
                 visible='`${debug}`'
                 desc=''
                 editable='false'
                 default='`${"pass[" . inst_pass . "].sar[" . inst_sar . "].group[" . inst_group . "]"}`'/>

<!-- LPPASS external variables -->
    <ParamString id='operatingMode' name='operatingMode' group='Internal' visible='false' desc='' editable='false' default='`${getExposedMember(resource_ac, "opMode")}`'/>
    <ParamString id='lpAutosetConversionRate' name='lpAutosetConversionRate' group='Internal' visible='false' desc='' editable='false' default='`${getExposedMember(resource_sar, "sar_lpAutosetConversionRate")}`'/>
    <ParamString id='hsAutosetConversionRate' name='hsAutosetConversionRate' group='Internal' visible='false' desc='' editable='false' default='`${getExposedMember(resource_sar, "sar_hsAutosetConversionRate")}`'/>
    <ParamString id='accMode' name='accMode' group='Internal' visible='false' desc='' editable='false' default='`${getExposedMember(resource_sar, "sar_accumulationMode")}`'/>
    <ParamString id='channelGpioEnable' name='channelGpioEnable' group='Internal' visible='false' desc='' editable='false' default='`${getExposedMember(resource_sar, "sar_hsGpioResultMaskValue")}`'/>
    <ParamString id='channelMuxEnable' name='channelMuxEnable' group='Internal' visible='false' desc='' editable='false' default='`${getExposedMember(resource_sar, "sar_lpMuxResultMaskValue")}`'/>
    <ParamString id='simultaneousSampling' name='simultaneousSampling' group='Internal' visible='false' desc='' editable='false' default='`${getExposedMember(resource_group, "simultaneousSampling")}`'/>

    <Repeat count='8'>
      <ParamString id='sar_gpiochan_$idx_enabled' name='sar_gpiochan_$idx_enabled' group='Internal' visible='false' desc='' editable='false' default='`${getExposedMember(resource_sar, "sar_gpiochan_$idx_enabled")}`'/>
    </Repeat>

    <Repeat count='16'>
      <ParamString id='sar_muxchan_$idx_enabled' name='sar_muxchan_$idx_enabled' group='Internal' visible='false' desc='' editable='false' default='`${getExposedMember(resource_sar, "sar_muxchan_$idx_enabled")}`'/>
      <ParamString id='muxchan_$idx_pseudoDiffMode' name='muxchan_$idx_pseudoDiffMode' group='Internal' visible='false' desc='' editable='false' default='`${sar_muxchan_$idx_enabled ? getExposedMember("pass[" . inst_pass . "].sar[" . inst_sar . "].muxchan[" . $idx . "]",  "sar_mux_pseudoDiffMode") : false}`'/>
    </Repeat>

<!-- SAR-level data used to compute Achieved Conversion Time, Result Format and Sequencer Index -->
    <ParamString id='inst_scan' name='inst_scan' group='Internal' visible='`${debug}`' editable='false' desc='' default='`${getInstNumber("scan")}`'/>
    <ParamString id='adcClockFreq' name='adcClockFreq' group='Internal' visible='`${debug}`' editable='false' desc='' default='`${getExposedMember(resource_sar, "sar_adcClockFreq")}`'/>
    <ParamString id='vrefValue' name='vrefValue' group='Internal' visible='`${debug}`' editable='false' desc='' default='`${getExposedMember(resource_sar, "sar_vrefValue")}`'/>
    <ParamString id='includeChannelId' name='includeChannelId' group='Internal' visible='`${debug}`' editable='false' desc='' default='`${getExposedMember(resource_sar, "sar_includeChannelId")}`'/>
    <ParamString id='accShiftMode' name='accShiftMode' group='Internal' visible='`${debug}`' editable='false' desc='' default='`${getExposedMember(resource_sar, "sar_accumulationShiftMode")}`'/>
    <ParamString id='differentialMode' name='differentialMode' group='Internal' visible='`${debug}`' editable='false' desc='' default='`${getExposedMember(resource_sar, "sar_differentialMode")}`'/>

    <Repeat count='4'>
      <ParamString id='globalSampleTime$idx' name='globalSampleTime$idx' group='Internal' visible='`${debug}`' editable='false' desc='' default='`${getExposedMember(resource_sar, "sar_globalSampleTime$idx")}`'/>
    </Repeat>

    <Repeat count='32'>
      <ParamString id='groupScanCnt$idx' name='groupScanCnt$idx' group='Internal' visible='`${debug}`' editable='false' desc='' default='`${getExposedMember(resource_sar, "sar_group_$idx_scanCnt")}`'/>
    </Repeat>

<!-- LPPASS internal parameters -->
    <ParamString id='rootGroupName' name='rootGroupName' group='Internal' visible='`${debug}`' desc='' editable='false'
                 default='Sequencer Configuration'/>

    <ParamChoice id='channelMux'
                 name='Channel'
                 group='`${rootGroupName}`'
                 visible='`${(channelMuxEnable) &amp;&amp; (operatingMode eq "LowPower")}`'
                 editable='true'
                 desc='List of configured Mux channels'
                                   default='CY_AUTANALOG_SAR_CHAN_CFG_MUX0'>
      <Entry name='Mux channel $idx' value='CY_AUTANALOG_SAR_CHAN_CFG_MUX$idx' visible='`${sar_muxchan_$idx_enabled}`' repeatCount='16'/>
    </ParamChoice>

    <ParamChoice id='channelGpio'
                 name='Channel'
                 group='`${rootGroupName}`'
                 visible='`${(channelGpioEnable || channelMuxEnable) &amp;&amp; (operatingMode eq "HighSpeed") &amp;&amp; (!simultaneousSampling)}`'
                 editable='true'
                 desc='List of configured Mux and GPIO channels'
                                        default='CY_AUTANALOG_SAR_CHAN_MASK_GPIO_DISABLED'>
      <Entry name='Disabled'              value='CY_AUTANALOG_SAR_CHAN_MASK_GPIO_DISABLED' visible='true'/>
      <Entry name='MUX channel $idx'      value='CY_AUTANALOG_SAR_CHAN_CFG_MUX$idx'   visible='`${sar_muxchan_$idx_enabled}`'  repeatCount='16'/>
      <Entry name='GPIO channel $idx'     value='CY_AUTANALOG_SAR_CHAN_MASK_GPIO$idx' visible='`${sar_gpiochan_$idx_enabled}`' repeatCount='8'/>
    </ParamChoice>

    <Repeat count='2'>
       <ParamBool id='channelMux$idx'
               name='Mux Channel $idx'
               group='`${rootGroupName}`'
               visible='`${(channelMuxEnable) &amp;&amp; (operatingMode eq "HighSpeed") &amp;&amp; (simultaneousSampling)}`'
               editable='true'
               desc='Enable Mux Channel $idx in Scan'
               default='false'/>
    </Repeat>

    <Repeat count='8'>
        <ParamBool id='channelGpio$idx'
               name='GPIO Channel $idx'
               group='`${rootGroupName}`'
               visible='`${(channelGpioEnable) &amp;&amp; (operatingMode eq "HighSpeed") &amp;&amp; (simultaneousSampling) &amp;&amp; (sar_gpiochan_$idx_enabled)}`'
               editable='true'
               desc='Enable GPIO Channel $idx in Scan'
               default='false'/>
    </Repeat>

    <Repeat count='2'>
       <ParamChoice id='sar_mux_$idxChoice'
                 name='Mux Channel $idx'
                 group='`${rootGroupName}`'
                 visible='`${(channelMuxEnable) &amp;&amp; (operatingMode eq "HighSpeed") &amp;&amp; (simultaneousSampling) &amp;&amp; (channelMux$idx)}`'
                 editable='true'
                 desc='List of configured Mux channels'
                                      default='CY_AUTANALOG_SAR_CHAN_CFG_MUX0'>
         <Entry name='Mux channel $idx' value='CY_AUTANALOG_SAR_CHAN_CFG_MUX$idx' visible='`${sar_muxchan_$idx_enabled}`' repeatCount='16'/>
       </ParamChoice>
    </Repeat>

    <ParamBool id='sampleTimeEnable'
               name='Sample Time'
               group='`${rootGroupName}`'
               visible='`${(channelMuxEnable || channelGpioEnable)}`'
               editable='`${!(operatingMode eq "HighSpeed" ? hsAutosetConversionRate : lpAutosetConversionRate)}`'
               desc='Enable a Global Sampling time for this scan'
               default='`${!(operatingMode eq "HighSpeed" ? hsAutosetConversionRate : lpAutosetConversionRate)}`'/>

    <ParamChoice id='sampleTimeSelect'
                 name='Sample Time Select'
                 group='`${rootGroupName}`'
                 visible='`${(channelMuxEnable || channelGpioEnable) &amp;&amp; (sampleTimeEnable)}`'
                 editable='true'
                 desc='Sample time clocks, uS'
                                          default='CY_AUTANALOG_SAR_SAMPLE_TIME0'>
      <Entry name='Global Sample Time $idx' value='CY_AUTANALOG_SAR_SAMPLE_TIME$idx' visible='true' repeatCount='4'/>
    </ParamChoice>

    <ParamBool id='accumulationEnable'
               name='Accumulation Enable'
               group='`${rootGroupName}`'
               visible='`${(channelMuxEnable || channelGpioEnable) &amp;&amp; (accMode ne "CY_AUTANALOG_SAR_ACC_DISABLED")}`'
               editable='`${!(operatingMode eq "HighSpeed" ? hsAutosetConversionRate : lpAutosetConversionRate)}`'
               desc='Enable accumulation over multiple samples'
               default='`${!(operatingMode eq "HighSpeed" ? hsAutosetConversionRate : lpAutosetConversionRate)}`'/>

    <ParamChoice id='accCount'
                 name='Accumulation Count'
                 group='`${rootGroupName}`'
                 visible='`${(channelMuxEnable || channelGpioEnable) &amp;&amp; (accumulationEnable) &amp;&amp; (accMode ne "CY_AUTANALOG_SAR_ACC_DISABLED")}`'
                 editable='true'
                 desc='Number of samples accumulated '
                    default='CY_AUTANALOG_SAR_ACC_CNT2'>
      <Entry name='2'   value='CY_AUTANALOG_SAR_ACC_CNT2'   visible='true'/>
      <Entry name='4'   value='CY_AUTANALOG_SAR_ACC_CNT4'   visible='true'/>
      <Entry name='8'   value='CY_AUTANALOG_SAR_ACC_CNT8'   visible='true'/>
      <Entry name='16'  value='CY_AUTANALOG_SAR_ACC_CNT16'  visible='true'/>
      <Entry name='32'  value='CY_AUTANALOG_SAR_ACC_CNT32'  visible='true'/>
      <Entry name='64'  value='CY_AUTANALOG_SAR_ACC_CNT64'  visible='true'/>
      <Entry name='128' value='CY_AUTANALOG_SAR_ACC_CNT128' visible='true'/>
      <Entry name='256' value='CY_AUTANALOG_SAR_ACC_CNT256' visible='true'/>
    </ParamChoice>

<!-- Achieved Conversion Time helpers, declared right after the
     accumulation parameters they depend on (declaration-order evaluation). -->
    <ParamString id='selectedSampleClocks' name='selectedSampleClocks' group='Internal' visible='`${debug}`' editable='false' desc=''
                 default='`${!sampleTimeEnable ? globalSampleTime0 :
                             (sampleTimeSelect eq CY_AUTANALOG_SAR_SAMPLE_TIME1) ? globalSampleTime1 :
                             (sampleTimeSelect eq CY_AUTANALOG_SAR_SAMPLE_TIME2) ? globalSampleTime2 :
                             (sampleTimeSelect eq CY_AUTANALOG_SAR_SAMPLE_TIME3) ? globalSampleTime3 : globalSampleTime0}`'/>

    <ParamString id='accCountNum' name='accCountNum' group='Internal' visible='`${debug}`' editable='false' desc=''
                 default='`${(accumulationEnable &amp;&amp; (accMode ne "CY_AUTANALOG_SAR_ACC_DISABLED")) ?
                             ((accCount eq CY_AUTANALOG_SAR_ACC_CNT2)   ? 2   :
                              (accCount eq CY_AUTANALOG_SAR_ACC_CNT4)   ? 4   :
                              (accCount eq CY_AUTANALOG_SAR_ACC_CNT8)   ? 8   :
                              (accCount eq CY_AUTANALOG_SAR_ACC_CNT16)  ? 16  :
                              (accCount eq CY_AUTANALOG_SAR_ACC_CNT32)  ? 32  :
                              (accCount eq CY_AUTANALOG_SAR_ACC_CNT64)  ? 64  :
                              (accCount eq CY_AUTANALOG_SAR_ACC_CNT128) ? 128 :
                              (accCount eq CY_AUTANALOG_SAR_ACC_CNT256) ? 256 : 1) : 1}`'/>

    <ParamString id='conversionTimeSec' name='conversionTimeSec' group='Internal' visible='`${debug}`' editable='false' desc=''
                 default='`${(cast(float, adcClockFreq) &gt; 0.0) ? ((cast(float, selectedSampleClocks) + 16.0) * cast(float, accCountNum) / cast(float, adcClockFreq)) : 0.0}`'/>

    <ParamChoice id='calibrationInRuntime'
                 name='Calibration in Runtime'
                 group='`${rootGroupName}`'
                 visible='false'
                 editable='true'
                 desc='A real-time calibration channel request'
                                       default='CY_AUTANALOG_SAR_CAL_DISABLED'>
      <Entry name='Disabled'             value='CY_AUTANALOG_SAR_CAL_DISABLED'  visible='true'/>
      <Entry name='Offset and Linearity' value='CY_AUTANALOG_SAR_CAL_BOTH'      visible='true'/>
      <Entry name='Offset Only'          value='CY_AUTANALOG_SAR_CAL_OFFSET'    visible='true'/>
      <Entry name='Linearity Only'       value='CY_AUTANALOG_SAR_CAL_LINEARITY' visible='true'/>
    </ParamChoice>

    <ParamString id='nonSimultaneousSamplingGPIOch' name='nonSimultaneousSamplingGPIOch' group='Internal' visible='`${debug}`' desc='' editable='false'
        default='`${(channelGpio eq CY_AUTANALOG_SAR_CHAN_MASK_GPIO0) ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO0" :
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_MASK_GPIO1) ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO1" :
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_MASK_GPIO2) ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO2" :
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_MASK_GPIO3) ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO3" :
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_MASK_GPIO4) ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO4" :
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_MASK_GPIO5) ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO5" :
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_MASK_GPIO6) ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO6" :
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_MASK_GPIO7) ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO7" :
                     "CY_AUTANALOG_SAR_CHAN_MASK_GPIO_DISABLED"}`' />

    <ParamString id='simultaneousSamplingGPIOch' name='simultaneousSamplingGPIOch' group='Internal' visible='`${debug}`' desc='' editable='false'
        default='`${" &#13; " .
                  (       !(channelGpio0 || channelGpio1 || channelGpio2 || channelGpio3 || channelGpio4 || channelGpio5 || channelGpio6 || channelGpio7) ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO_DISABLED"  : "") .
                  (channelGpio0 &amp;&amp; (channelGpio1 || channelGpio2 || channelGpio3 || channelGpio4 || channelGpio5 || channelGpio6 || channelGpio7) ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO0 | &#13; " : channelGpio0 ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO0" : "") .
                  (channelGpio1 &amp;&amp; (                channelGpio2 || channelGpio3 || channelGpio4 || channelGpio5 || channelGpio6 || channelGpio7) ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO1 | &#13; " : channelGpio1 ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO1" : "") .
                  (channelGpio2 &amp;&amp; (                                channelGpio3 || channelGpio4 || channelGpio5 || channelGpio6 || channelGpio7) ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO2 | &#13; " : channelGpio2 ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO2" : "") .
                  (channelGpio3 &amp;&amp; (                                                channelGpio4 || channelGpio5 || channelGpio6 || channelGpio7) ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO3 | &#13; " : channelGpio3 ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO3" : "") .
                  (channelGpio4 &amp;&amp; (                                                                channelGpio5 || channelGpio6 || channelGpio7) ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO4 | &#13; " : channelGpio4 ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO4" : "") .
                  (channelGpio5 &amp;&amp; (                                                                                channelGpio6 || channelGpio7) ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO5 | &#13; " : channelGpio5 ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO5" : "") .
                  (channelGpio6 &amp;&amp; (                                                                                                channelGpio7) ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO6 | &#13; " : channelGpio6 ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO6" : "") .
                  (channelGpio7 ? "CY_AUTANALOG_SAR_CHAN_MASK_GPIO7" : "")}`' />

    <ParamString id='nonSimultaneousMuxMode' name='nonSimultaneousMuxMode' group='Internal' visible='`${debug}`' desc='' editable='false'
        default='`${(channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX0)  &amp;&amp; (muxchan_0_pseudoDiffMode)  ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX1)  &amp;&amp; (muxchan_1_pseudoDiffMode)  ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX2)  &amp;&amp; (muxchan_2_pseudoDiffMode)  ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX3)  &amp;&amp; (muxchan_3_pseudoDiffMode)  ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX4)  &amp;&amp; (muxchan_4_pseudoDiffMode)  ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX5)  &amp;&amp; (muxchan_5_pseudoDiffMode)  ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX6)  &amp;&amp; (muxchan_6_pseudoDiffMode)  ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX7)  &amp;&amp; (muxchan_7_pseudoDiffMode)  ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX8)  &amp;&amp; (muxchan_8_pseudoDiffMode)  ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX9)  &amp;&amp; (muxchan_9_pseudoDiffMode)  ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX10) &amp;&amp; (muxchan_10_pseudoDiffMode) ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX11) &amp;&amp; (muxchan_11_pseudoDiffMode) ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX12) &amp;&amp; (muxchan_12_pseudoDiffMode) ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX13) &amp;&amp; (muxchan_13_pseudoDiffMode) ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX14) &amp;&amp; (muxchan_14_pseudoDiffMode) ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX15) &amp;&amp; (muxchan_15_pseudoDiffMode) ?
                    "CY_AUTANALOG_SAR_CHAN_CFG_MUX0_PSEUDO_DIFF" :
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX0)  ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX1)  ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX2)  ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX3)  ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX4)  ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX5)  ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX6)  ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX7)  ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX8)  ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX9)  ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX10) ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX11) ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX12) ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX13) ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX14) ||
                    (channelGpio eq CY_AUTANALOG_SAR_CHAN_CFG_MUX15) ?
                     "CY_AUTANALOG_SAR_CHAN_CFG_MUX0_SINGLE_ENDED" :
                     "CY_AUTANALOG_SAR_CHAN_CFG_MUX_DISABLED"}`' />

    <ParamString id='simultaneousMuxMode' name='simultaneousMuxMode' group='Internal' visible='`${debug}`' desc='' editable='false'
        default='`${channelMux0 &amp;&amp;
                    ((sar_mux_0Choice eq CY_AUTANALOG_SAR_CHAN_CFG_MUX0)  &amp;&amp; (muxchan_0_pseudoDiffMode)  ||
                     (sar_mux_0Choice eq CY_AUTANALOG_SAR_CHAN_CFG_MUX1)  &amp;&amp; (muxchan_1_pseudoDiffMode)  ||
